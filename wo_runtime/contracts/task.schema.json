{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime Task",
  "description": "Domain-neutral task envelope for file-queue orchestration. Worker payload fields are instance-defined.",
  "type": "object",
  "required": [
    "id",
    "req_id",
    "capability",
    "depends_on",
    "queue_contract"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+~-]*$"
    },
    "req_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+~-]*$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "stage": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+~-]*$"
      },
      "default": []
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "is_root": {
      "type": "boolean",
      "default": false
    },
    "manualOnly": {
      "type": "boolean",
      "default": false,
      "description": "When true, generic/model worker claim commands must not reserve this task."
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Binding to a committed request_plan.v1 manifest. Absent on unmanaged legacy tasks."
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "queue_contract": {
      "type": "string",
      "enum": [
        "queue.v2"
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "lease_id",
        "worker",
        "attempt",
        "claimed_at",
        "lease_expires_at",
        "capability"
      ],
      "properties": {
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+~-]*$"
        },
        "worker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "claimed_at": {
          "type": "string"
        },
        "lease_expires_at": {
          "type": "string"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      },
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
