{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime Result",
  "description": "Domain-neutral task result envelope written by queue workers or the orchestrator.",
  "type": "object",
  "required": [
    "task_id",
    "worker",
    "status",
    "queue_contract",
    "lease_id",
    "attempt",
    "result_digest"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+~-]*$"
    },
    "worker": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ]
    },
    "artifact_type": {
      "type": "string"
    },
    "result": {
      "description": "Worker-defined artifact payload. Root task results become the request deliverable.",
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "assetManifest": {
      "$ref": "asset-manifest.schema.json"
    },
    "recovery": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "queue_contract": {
      "type": "string",
      "enum": [
        "queue.v2"
      ]
    },
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+~-]*$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
