{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime Asset Manifest",
  "description": "Domain-neutral manifest for generated or assembled assets.",
  "type": "object",
  "required": ["schema", "producerTaskId", "assets"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "asset_manifest.v1"
    },
    "producerTaskId": {
      "type": "string",
      "minLength": 1
    },
    "reqId": {
      "type": "string"
    },
    "assetKind": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetKind", "name", "path", "status", "producerTaskId"],
        "properties": {
          "assetKind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "optionsHash": {
            "type": "string"
          },
          "dependencyHash": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["success", "failed", "pending", "skipped"]
          },
          "producerTaskId": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string"
          },
          "relatedRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
